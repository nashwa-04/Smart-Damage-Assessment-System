@push('styles')
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<style>
    .image-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 1rem;
    }
    .image-card {
        position: relative;
        aspect-ratio: 4/3;
        overflow: hidden;
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .image-card:hover {
        transform: scale(1.03);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
    }
    .image-card img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .lightbox {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.95);
        z-index: 9999;
        justify-content: center;
        align-items: center;
    }
    .lightbox.active {
        display: flex;
    }
</style>
@endpush

